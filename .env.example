# ============================================================
# CONTOH ENVIRONMENT VARIABLES
# Salin file ini ke .env dan isi dengan nilai yang sebenarnya
# ============================================================

# Django
SECRET_KEY=your-secret-key-here-ganti-dengan-yang-aman
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# (Opsional) Jika punya custom domain
# CUSTOM_DOMAIN=yourdomain.com

# Database - Neon PostgreSQL
# Ambil dari dashboard Neon: https://console.neon.tech/
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloudinary
# Ambil dari dashboard Cloudinary: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
